// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Purchase {
  id Int @id @default(autoincrement())
  itemId String
  userId String
}

model Item {
  id Int @id @default(autoincrement())
  name String @unique
  price Int
}

model LedgerEntry {
  id Int @id @default(autoincrement())
  amount Int 
  userId String
}


